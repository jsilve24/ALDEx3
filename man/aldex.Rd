C <- matrix(c(0, 1), 1, dimnames = list("group difference", colnames(X)))
fit <- aldex(Y, ~ group, metadata, nsample = 8, scale = clr.sm,
             gamma = 0.2, contrasts = C)
summary(fit, component = "contrasts")

